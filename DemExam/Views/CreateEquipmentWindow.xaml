<Window x:Class="DemExam.Views.CreateEquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemExam.Views"
        mc:Ignorable="d"
        Title="CreateEquipmentWindow" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с кнопками -->
        <Grid Grid.Row="0" Margin="5">
            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left">
                <Button Content="Назад"
                    Width="100"
                    Click="BackButton_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button Content="Добавить"
                    Width="100"
                    Click="AddButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1">
                <!-- Название -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Название" Width="100"/>
                    <TextBox x:Name="NameTextBox" Width="300"/>
                </StackPanel>
                <TextBlock x:Name="NameError" Foreground="Red" FontSize="10" Margin="105,0,0,5"/>

                <!-- Инвентарный номер -->
                <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Left">
                    <TextBlock Text="Инвентарный номер" Width="400"/>
                    <TextBox x:Name="InventoryNumberTextBox" Width="400"/>
                </StackPanel>
                <TextBlock x:Name="InventoryError" Foreground="Red" FontSize="10" Margin="5,0,0,5"/>

                <!-- Вес -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Вес" Width="40"/>
                    <TextBox x:Name="WeightTextBox" Width="300"/>
                </StackPanel>
                <TextBlock x:Name="WeightError" Foreground="Red" FontSize="10" Margin="105,0,0,5"/>

                <!-- Срок службы -->
                <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Left">
                    <TextBlock Text="Срок службы (лет)" Width="400"/>
                    <TextBox x:Name="StandartTimeLimitTextBox"
                         Width="400"/>
                </StackPanel>
                <TextBlock x:Name="TimeLimitError" Foreground="Red" FontSize="10" Margin="5,0,0,5"/>

                <!-- Подразделение -->
                <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Left">
                    <TextBlock Text="Подразделение" Width="400"/>
                    <ComboBox x:Name="OfficeComboBox" 
                          Width="400"
                          DisplayMemberPath="ShortName"
                          SelectedValuePath="Id"
                          SelectionChanged="OfficeComboBox_SelectionChanged"/>
                </StackPanel>
                <TextBlock x:Name="OfficeError" Foreground="Red" FontSize="10" Margin="5,0,0,5"/>

                <!-- Аудитория -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Аудитория" Width="100"/>
                    <ComboBox x:Name="AuditoriumComboBox" 
                      Width="300"
                      DisplayMemberPath="AuditoriumNumber"
                      SelectedValuePath="Id"/>
                </StackPanel>
                <TextBlock x:Name="AuditoriumError" Foreground="Red" FontSize="10" Margin="105,0,0,5"/>

                <!-- Дата поставки -->
                <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Left">
                    <TextBlock Text="Дата поставки" Width="400"/>
                    <DatePicker x:Name="TransferDatePicker" Width="400"/>
                </StackPanel>
                <!-- Описание -->
                <StackPanel Orientation="Vertical" Margin="5" HorizontalAlignment="Left">
                    <TextBlock Text="Описание" Width="100" HorizontalAlignment="Left"/>
                    <TextBox x:Name="DescriptionTextBox" Width="300" Height="100"/>
                </StackPanel>
            </StackPanel>

            <!-- Фото -->
            <StackPanel Grid.Column="0">
                <Button x:Name="AddPhotoButton"
                    Content="Добавить фото"
                    Height="35"
                    Click="BrowsePhoto_Click"/>
                <Border BorderBrush="Gray"
                    BorderThickness="1"
                    Height="300"
                    Margin="0,10,0,0">
                    <Image x:Name="PhotoImage"
                       Stretch="Uniform"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
