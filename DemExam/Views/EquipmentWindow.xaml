<Window x:Class="DemExam.Views.EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemExam.Views"
        mc:Ignorable="d"
        Title="Оборудование" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Background="#FFA500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/Res/logo.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30 0 0 0" Width="50" Height="50"/>
            <TextBlock Grid.Column="1" Name="FullName" Text="{Binding FullName}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Name="LogoutButton" Content="Выйти" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10 0"
                Click="LogoutButton_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl Name="EquipmentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Tag="{Binding Id}" BorderThickness="1" BorderBrush="Black" Width="860">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="600"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="250" Height="250" Margin="15 0" HorizontalAlignment="Center">
                                    <Image Source="{Binding Photo}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20 0">
                                    <TextBlock FontWeight="SemiBold" Margin="0 15" VerticalAlignment="Center" Text="{Binding NameEquipment}"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    <Border Width="auto" Height="30" HorizontalAlignment="Left" 
                                            Visibility="{Binding Visibility}" 
                                            Background="{Binding Background}">
                                        <TextBlock Text="{Binding Text}" TextAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Margin="0 10">
                                        <Run Text="Аудитория: "/>
                                        <Run Text="{Binding IdAuditoriumNavigation.AuditoriumName}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0 10">
                                        <Run Text="Подразделение: "/>
                                        <Run Text="{Binding IdAuditoriumNavigation.IdOfficeNavigation.ShortName}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
