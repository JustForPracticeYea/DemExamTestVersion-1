<Window x:Class="DemExam.Views.EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DemExam.Views"
        mc:Ignorable="d"
        Title="Оборудование" Height="800" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="47*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#FFA500">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="/Res/logo.png" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30 0 0 0" Width="50" Height="50"/>
            <TextBlock Grid.Column="1" Name="FullName" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            <Button Name="LogoutButton" Content="Выйти" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10 0"
                Click="LogoutButton_Click"/>
        </Grid>

        <!--Поиск, сортировка, фильтр-->
        <StackPanel x:Name="ControlPanel" Orientation="Horizontal" Grid.Row="1" Grid.Column="1"
             HorizontalAlignment="Left" 
             Margin="158,5,0,5">
            <TextBox HorizontalAlignment="Center"
              Height="40"
              Name="SearchTextBox"
              BorderBrush="Black"
              BorderThickness="1"
              Width="300"
              TextChanged="OnSearchTextChanged">
            </TextBox>

            <ComboBox Name="SortComboBox"
               Width="200" 
               Margin="5"
               VerticalAlignment="Center"
               SelectionChanged="OnFilterChanged"/>

            <ComboBox Name="FilterComboBox"
               Width="200"
               Margin="5,0"
               VerticalAlignment="Center"
               SelectionChanged="OnFilterOfficeChanged"/>

            <Button Name="ButtonCreateEquipment"
                 Content="Добавить"
                 Width="100"
                 Margin="40 0"
                 Height="50"
                 Click="CreateEquipmentButton_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Grid.Column="1" Width="1000">
            <ListBox Name="EquipmentList"
                     SelectionChanged="EquipmentListSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Tag="{Binding Id}" BorderThickness="1" BorderBrush="Black" Width="860">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="600"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="250" Height="250" Margin="15 0" HorizontalAlignment="Center">
                                    <Image Source="{Binding ImageSource}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20 0">
                                    <TextBlock FontWeight="SemiBold" Margin="0 15" VerticalAlignment="Center" Text="{Binding NameEquipment}"/>
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    <Border Width="auto" Height="30" HorizontalAlignment="Left" 
                                            Visibility="{Binding Visibility}" 
                                            Background="{Binding Background}">
                                        <TextBlock Text="{Binding Text}" TextAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Margin="0 10" Visibility="{Binding AuditoriumVisibility}">
                                        <Run Text="Аудитория: "/>
                                        <Run Text="{Binding IdPlaceNavigation.AuditoriumNumber}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0 10">
                                        <Run Text="Подразделение: "/>
                                        <Run Text="{Binding IdPlaceNavigation.IdOfficeNavigation.ShortName}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</Window>
